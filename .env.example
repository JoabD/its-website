# Referencia de las variables de entorno reales que necesita este proyecto en producción
# (Azure App Service / MonsterASP.NET). No hay ningún .env que un proceso local lea directamente:
# en desarrollo estos mismos valores van en backend/src/Shekinah.Api/appsettings.Development.json
# (git-ignored); en producción van como Application Settings / variables de entorno del panel del
# host — nunca en un archivo versionado (R8). Ver PROMPT-MAESTRO.md §3-bis.

# Cadena de conexión a MongoDB. Local: mongodb://localhost:27017/  ·  Producción: la cadena SRV
# real de tu clúster de MongoDB Atlas (mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/shekinah?retryWrites=true&w=majority)
Mongo__ConnectionString=mongodb://localhost:27017/

# Clave de firma JWT — al menos 32 caracteres aleatorios en cualquier entorno real.
Jwt__SigningKey=CAMBIA-ESTA-CLAVE-POR-UNA-DE-AL-MENOS-32-CARACTERES-ALEATORIOS

# Gmail SMTP (ver PROMPT-MAESTRO.md §3-bis): SenderAppPassword es una contraseña de aplicación de
# Gmail, no la contraseña real de la cuenta.
EmailSettings__SenderAppPassword=CAMBIA-POR-TU-APP-PASSWORD-DE-GMAIL

# Contraseña temporal del usuario administrador sembrado por DatabaseSeeder al primer arranque.
# RN-24 obliga a cambiarla en el primer login.
Seed__AdminPassword=CambiaEsteTemporal123
