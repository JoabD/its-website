<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Fase 3 (criterio de aceptación): tests con Testcontainers que arrancan un Mongo real y verifican
    repositorios, índices únicos, rollback transaccional y el generador de matrícula bajo concurrencia.
    Requieren Docker disponible en la máquina que ejecuta `dotnet test` — se omiten en este entregable
    inicial (documentado en docs/DECISIONS.md) y quedan como el siguiente paso natural del proyecto.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.v3" Version="1.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.1" />
    <PackageReference Include="Shouldly" Version="4.2.1" />
    <PackageReference Include="Testcontainers.MongoDb" Version="4.1.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shekinah.Infrastructure\Shekinah.Infrastructure.csproj" />
  </ItemGroup>

</Project>
