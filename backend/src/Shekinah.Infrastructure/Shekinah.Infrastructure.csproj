<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Shekinah.Infrastructure</RootNamespace>
    <AssemblyName>Shekinah.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.1.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="SharpCompress" Version="0.48.1" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="Polly" Version="8.5.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <!-- Fase 8 (Kardex): generación de PDF institucional. QuestPDF es gratuita bajo licencia
         Community para empresas con ingresos anuales menores a 1M USD (ver QuestPdfSettings.cs,
         donde se fija License = LicenseType.Community). -->
    <PackageReference Include="QuestPDF" Version="2025.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- IHttpContextAccessor, ClaimsPrincipal.FindFirstValue y AddHttpContextAccessor solo se
         distribuyen en el framework compartido de ASP.NET Core (no como paquete NuGet aparte
         desde .NET 3.0+); ver Auth/HttpCurrentUser.cs y DependencyInjection.cs. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shekinah.Domain\Shekinah.Domain.csproj" />
    <ProjectReference Include="..\Shekinah.Application\Shekinah.Application.csproj" />
  </ItemGroup>

  <!-- Logo institucional embebido como recurso del ensamblado (no un archivo suelto en disco):
       así el PDF de la ficha de inscripción (AdmissionFichaPdfGenerator) siempre puede cargarlo sin
       depender del working directory del proceso ni de que exista wwwroot en el servidor. -->
  <ItemGroup>
    <EmbeddedResource Include="Documents\Assets\shekina-logo.png" />
  </ItemGroup>

</Project>
